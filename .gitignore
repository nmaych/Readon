# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
.gradle/
build/
*.class
*.dex
*.ap_
*.apk
*.aab
*.ap_
*.prof
*.hprof
captures/
.externalNativeBuild/
.cxx/

# Keep the Gradle wrapper jar: it is a checked-in binary, not build output, and
# a blanket *.jar rule above would silently break every clone's build.
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------------
# Signing material -- must never be committed
# ---------------------------------------------------------------------------
# The release key and its passwords. Losing them is a problem; leaking them is
# worse: anyone with the key can publish an APK that upgrades over a real
# install. CI reads them from repository secrets instead.
keystore/
*.jks
*.keystore
keystore.properties

# Points at a local SDK path; regenerated by build.cmd on every run.
local.properties

# ---------------------------------------------------------------------------
# IDE
# ---------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
.vscode/

# ---------------------------------------------------------------------------
# Release artefacts
# ---------------------------------------------------------------------------
# dist/update.json is tracked -- the app fetches it from this branch, so it has
# to be in the repository. The APKs are not: they are published as release
# assets, and a 11 MB binary in git history on every release is pure bloat.
dist/*.apk
dist/*.apk.sha256

# ---------------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------------
*.log
*.tmp
*.part
.DS_Store
Thumbs.db
__pycache__/
*.pyc
